+
+/**
+ * @file
+ * Calculate the SSIMULACRA2 score between two input videos.
+ */
+
+#include <ssimu2.h>
+
+#include "libavutil/avstring.h"
+#include "libavutil/dict.h"
+#include "libavutil/intmath.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+#include "libavutil/imgutils.h"
+#include "libavutil/thread.h"
+#include "avfilter.h"
+#include "filters.h"
+#include "framesync.h"
+#include "video.h"
+
+#include <float.h>
+#include <math.h>
+#include <inttypes.h>
+#include <string.h>
+
+typedef struct LIBSSIMU2Context {
+    const AVClass *class;
+    FFFrameSync fs;
+
+    int verbose;
+    int stats;
+
+    double score_sum;
+    double score_sumsq;
+    uint64_t nb_frames;
+    double min_score;
+    double max_score;
+
+    double *scores;
+    unsigned scores_alloc;
+    unsigned scores_len;
+
+    AVMutex lock;
+} LIBSSIMU2Context;
+
+typedef struct LibSsimu2Frame {
+    uint8_t *ref_buf;
+    uint8_t *dist_buf;
+    int      w;
+    int      h;
+    int      channels;
+    int      ref_linesize;
+    int      dist_linesize;
+} LibSsimu2Frame;
+
+typedef struct LibSsimu2Job {
+    LibSsimu2Frame *frames;
+    int             nb_frames;
+    double         *scores; /* nb_frames */
+    int             err;    /* first error code */
+} LibSsimu2Job;
+
+#define OFFSET(x) offsetof(LIBSSIMU2Context, x)
+#define FLAGS AV_OPT_FLAG_FILTERING_PARAM|AV_OPT_FLAG_VIDEO_PARAM
+
+static const AVOption libssimu2_options[] = {
+    { "stats", "Compute and log detailed summary stats (avg/min/max/stddev/median/p5/p95) on end.",
+      OFFSET(stats), AV_OPT_TYPE_BOOL, { .i64 = 1 }, 0, 1, FLAGS },
+    { "verbose", "Print per-frame SSIMULACRA2 scores.",
+      OFFSET(verbose), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, FLAGS },
+    { NULL }
+};
+
+FRAMESYNC_DEFINE_CLASS(libssimu2, LIBSSIMU2Context, fs);
+
+static int double_cmp_qsort(const void *ap, const void *bp)
+{
+    const double a = *(const double *)ap;
+    const double b = *(const double *)bp;
+    return (a > b) - (a < b);
+}
+
+static int do_ssimulacra(FFFrameSync *fs)
+{
+    AVFilterContext *ctx = fs->parent;
+    LIBSSIMU2Context *s = ctx->priv;
+    AVFrame *main, *ref;
+    int ret;
+
+    double score = 0.0;
+    const uint8_t *main_data, *ref_data;
+    uint8_t *main_packed = NULL;
+    uint8_t *ref_packed = NULL;
+
+    int channels;
+
+    ret = ff_framesync_dualinput_get(fs, &main, &ref);
+    if (ret < 0)
+        return ret;
+    if (ctx->is_disabled || !ref)
+        return ff_filter_frame(ctx->outputs[0], main);
+
+    switch (main->format) {
+    case AV_PIX_FMT_RGB24: channels = 3; break;
+    case AV_PIX_FMT_RGBA:  channels = 4; break;
+    case AV_PIX_FMT_GRAY8: channels = 1; break;
+    default:
+        return AVERROR(EINVAL);
+    }
+
+    /* NOTE on potential score mismatch:
+     * The reference fssimu2 CLI converts YUV420 -> RGB8 with its own conversion.
+     * Here we rely on FFmpeg's swscale conversion (via format=rgb24), which may
+     * not match exactly (matrix/range/transfer/rounding). If scores differ, the
+     * color conversion path is the most likely cause.
+     */
+
+    if (main->linesize[0] != main->width * channels) {
+        main_packed = av_malloc((size_t)main->width * main->height * channels);
+        if (!main_packed) {
+            ret = AVERROR(ENOMEM);
+            goto fail;
+        }
+        av_image_copy_plane(main_packed, main->width * channels,
+                            main->data[0], main->linesize[0],
+                            main->width * channels, main->height);
+        main_data = main_packed;
+    } else {
+        main_data = main->data[0];
+    }
+
+    if (ref->linesize[0] != ref->width * channels) {
+        ref_packed = av_malloc((size_t)ref->width * ref->height * channels);
+        if (!ref_packed) {
+            ret = AVERROR(ENOMEM);
+            goto fail;
+        }
+        av_image_copy_plane(ref_packed, ref->width * channels,
+                            ref->data[0], ref->linesize[0],
+                            ref->width * channels, ref->height);
+        ref_data = ref_packed;
+    } else {
+        ref_data = ref->data[0];
+    }
+
+    ret = ssimulacra2_score(ref_data, main_data, main->width, main->height, channels, &score);
+    if (ret != 0) {
+        av_log(ctx, AV_LOG_ERROR, "ssimulacra2_score failed\n");
+        ret = AVERROR_EXTERNAL;
+        goto fail;
+    }
+
+    /* store score as metadata string */
+    {
+        char buf[64];
+        snprintf(buf, sizeof(buf), "%f", score);
+        av_dict_set(&main->metadata, "lavfi.ssimu2.score", buf, 0);
+    }
+
+    if (s->verbose) {
+        av_log(ctx, AV_LOG_INFO, "SSIMULACRA2 score: %f\n", score);
+    }
+
+    /* Aggregate stats must be protected if frame-threading is enabled. */
+    ff_mutex_lock(&s->lock);
+
+    s->nb_frames++;
+    s->score_sum += score;
+    s->score_sumsq += score * score;
+    if (score < s->min_score) s->min_score = score;
+    if (score > s->max_score) s->max_score = score;
+
+    if (s->stats) {
+        if (s->scores_len == s->scores_alloc) {
+            unsigned new_alloc = s->scores_alloc ? s->scores_alloc * 2 : 1024;
+            double *tmp = av_realloc_f(s->scores, new_alloc, sizeof(*tmp));
+            if (tmp) {
+                s->scores = tmp;
+                s->scores_alloc = new_alloc;
+            } else {
+                /* keep avg/min/max/stddev, but disable percentile stats */
+                s->stats = 0;
+            }
+        }
+        if (s->stats && s->scores && s->scores_len < s->scores_alloc) {
+            s->scores[s->scores_len++] = score;
+        }
+    }
+
+    ff_mutex_unlock(&s->lock);
+
+    ret = ff_filter_frame(ctx->outputs[0], main);
+
+fail:
+    av_free(main_packed);
+    av_free(ref_packed);
+    return ret;
+}
+
+static av_cold int init(AVFilterContext *ctx)
+{
+    LIBSSIMU2Context *s = ctx->priv;
+
+    s->fs.on_event = do_ssimulacra;
+
+    s->score_sum = 0.0;
+    s->score_sumsq = 0.0;
+    s->nb_frames = 0;
+    s->min_score = DBL_MAX;
+    s->max_score = -DBL_MAX;
+
+    s->scores = NULL;
+    s->scores_alloc = 0;
+    s->scores_len = 0;
+
+    ff_mutex_init(&s->lock, NULL);
+
+    return 0;
+}
+
+static const enum AVPixelFormat pix_fmts[] = {
+    AV_PIX_FMT_RGB24,
+    AV_PIX_FMT_RGBA,
+    AV_PIX_FMT_GRAY8,
+    AV_PIX_FMT_NONE
+};
+
+static int config_input_ref(AVFilterLink *inlink)
+{
+    AVFilterContext *ctx = inlink->dst;
+    if (ctx->inputs[0]->w != ctx->inputs[1]->w ||
+        ctx->inputs[0]->h != ctx->inputs[1]->h) {
+        av_log(ctx, AV_LOG_ERROR, "Width and height of input videos must be same.\n");
+        return AVERROR(EINVAL);
+    }
+    if (ctx->inputs[0]->format != ctx->inputs[1]->format) {
+        av_log(ctx, AV_LOG_ERROR, "Inputs must be of same pixel format.\n");
+        return AVERROR(EINVAL);
+    }
+    return 0;
+}
+
+static int config_output(AVFilterLink *outlink)
+{
+    AVFilterContext *ctx = outlink->src;
+    LIBSSIMU2Context *s = ctx->priv;
+    AVFilterLink *mainlink = ctx->inputs[0];
+    FilterLink *il = ff_filter_link(mainlink);
+    FilterLink *ol = ff_filter_link(outlink);
+    int ret;
+
+    ret = ff_framesync_init_dualinput(&s->fs, ctx);
+    if (ret < 0)
+        return ret;
+    outlink->w = mainlink->w;
+    outlink->h = mainlink->h;
+    outlink->time_base = mainlink->time_base;
+    outlink->sample_aspect_ratio = mainlink->sample_aspect_ratio;
+    ol->frame_rate = il->frame_rate;
+
+    if ((ret = ff_framesync_configure(&s->fs)) < 0)
+        return ret;
+
+    return 0;
+}
+
+static int activate(AVFilterContext *ctx)
+{
+    LIBSSIMU2Context *s = ctx->priv;
+    return ff_framesync_activate(&s->fs);
+}
+
+static av_cold void uninit(AVFilterContext *ctx)
+{
+    LIBSSIMU2Context *s = ctx->priv;
+
+    ff_mutex_lock(&s->lock);
+
+    if (s->nb_frames > 0) {
+        const double avg = s->score_sum / (double)s->nb_frames;
+        const double mean_sq = s->score_sumsq / (double)s->nb_frames;
+        const double var = mean_sq - avg * avg;
+        const double stddev = var > 0.0 ? sqrt(var) : 0.0;
+
+        av_log(ctx, AV_LOG_INFO, "SSIMULACRA2 average score: %f\n", avg);
+        av_log(ctx, AV_LOG_INFO, "SSIMULACRA2 min score: %f\n", s->min_score);
+        av_log(ctx, AV_LOG_INFO, "SSIMULACRA2 max score: %f\n", s->max_score);
+
+        if (s->stats && s->scores && s->scores_len == (unsigned)s->nb_frames && s->scores_len > 0) {
+            double *tmp = av_malloc_array(s->scores_len, sizeof(*tmp));
+            if (tmp) {
+                memcpy(tmp, s->scores, s->scores_len * sizeof(*tmp));
+                qsort(tmp, s->scores_len, sizeof(*tmp), double_cmp_qsort);
+
+                av_log(ctx, AV_LOG_INFO, "SSIMULACRA2 stddev: %f\n", stddev);
+                av_log(ctx, AV_LOG_INFO, "SSIMULACRA2 median: %f\n", tmp[s->scores_len / 2]);
+                av_log(ctx, AV_LOG_INFO, "SSIMULACRA2 p5: %f\n", tmp[s->scores_len / 20]);
+                av_log(ctx, AV_LOG_INFO, "SSIMULACRA2 p95: %f\n", tmp[s->scores_len * 19 / 20]);
+
+                av_free(tmp);
+            } else {
+                av_log(ctx, AV_LOG_INFO, "SSIMULACRA2 stddev: %f\n", stddev);
+            }
+        } else {
+            av_log(ctx, AV_LOG_INFO, "SSIMULACRA2 stddev: %f\n", stddev);
+        }
+    }
+
+    av_freep(&s->scores);
+    s->scores_alloc = 0;
+    s->scores_len = 0;
+
+    ff_mutex_unlock(&s->lock);
+
+    ff_framesync_uninit(&s->fs);
+
+    ff_mutex_destroy(&s->lock);
+}
+
+static const AVFilterPad libssimu2_inputs[] = {
+    {
+        .name         = "main",
+        .type         = AVMEDIA_TYPE_VIDEO,
+    },
+    {
+        .name         = "reference",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .config_props = config_input_ref,
+    },
+};
+
+static const AVFilterPad libssimu2_outputs[] = {
+    {
+        .name          = "default",
+        .type          = AVMEDIA_TYPE_VIDEO,
+        .config_props  = config_output,
+    },
+};
+
+const FFFilter ff_vf_libssimu2 = {
+    .p.name        = "libssimu2",
+    .p.description = NULL_IF_CONFIG_SMALL("Calculate the SSIMULACRA2 score between two video streams."),
+    .p.priv_class  = &libssimu2_class,
+    .p.flags       = AVFILTER_FLAG_SUPPORT_TIMELINE_GENERIC,
+    .preinit       = libssimu2_framesync_preinit,
+    .init          = init,
+    .uninit        = uninit,
+    .activate      = activate,
+    .priv_size     = sizeof(LIBSSIMU2Context),
+    FILTER_INPUTS(libssimu2_inputs),
+    FILTER_OUTPUTS(libssimu2_outputs),
+    FILTER_PIXFMTS_ARRAY(pix_fmts),
+};
-- 
2.52.0

